# Optional endpoint for inquiry delivery. Receives a JSON POST.
# Use a serverless function, automation webhook, Resend adapter, Supabase function, etc.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# Optional analytics IDs can be wired into your chosen provider.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
